# Copia este archivo como .env.local y llena los valores
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Llave de servicio (Project Settings > API > service_role). NUNCA la compartas ni la pongas con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Dirección pública de la app (para los códigos QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enlace a osTicket para "levantar ticket"
NEXT_PUBLIC_OSTICKET_URL=https://soporte.pasteko.com.mx/open.php
